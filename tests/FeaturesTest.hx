import simplelfg.Config;
import simplelfg.Types;
import simplelfg.Parser;
import simplelfg.Board;
import simplelfg.Alerts;
import simplelfg.Geometry;
import simplelfg.Engine;
import TestMain.FakeChat;

class FeaturesTest {
    static var n=0;
    static function check(v:Bool,label:String):Void{n++;if(!v)throw label;}
    static function event(text:String,id:String="host",at:Float=100):ChatEnvelope return {text:text,senderId:id,senderName:id,channel:"All",receivedAt:at};
    static function main():Void {
        var c=new Config();c.requireRecruitingContext=true;var p=new Parser([{id:"test",name:"Test Cavern",aliases:["test cavern","tc"]}]);
        c.lfgWords=["party up"];check(p.parse(event("LFG TC"),c)==null,"removed solo phrase stops recognition");
        check(p.parse(event("Party up TC"),c).kind=="LFG","added phrase matches case independently");
        check(p.parse(event("party up unknown ruins"),c).target=="unknown ruins","custom phrase stripped from unknown target");
        c.lfmWords=["forming squad","lf#m"];check(p.parse(event("Forming Squad TC"),c).kind=="LFM","custom recruiting phrase");
        check(p.parse(event("LF2M TC"),c)!=null,"LF#M pattern");
        check(p.parse(event("misforming squadron TC"),c)==null,"word boundaries");
        c.excludedWords=["boost"];check(p.parse(event("LF2M TC boost"),c)==null,"excluded word");
        check(p.parse(event("LF2M TC booster"),c)!=null,"exclude uses word boundaries");
        c.excludedWords=[];check(p.parse(event("LF2M TC boost"),c)!=null,"removed exclusion");
        check(!Parser.matchesWords("LFM tc",[".*"]),"no regex execution");
        check(!Parser.matchesWords("forming squad TC",["forming-squad"]),"phrase punctuation remains literal");
        check(Parser.matchesWords("FORMING-SQUAD TC",["forming-squad"]),"literal punctuation matches case independently");
        check(!Parser.matchesWords("mylfg_word",["lfg"]),"underscore remains a word boundary constituent");
        var defaults=new Config();defaults.requireRecruitingContext=true;check(p.parse(event("TC needs a tank"),defaults)!=null,"default activity-plus-role recognition");
        defaults.lfmWords=[];check(p.parse(event("TC needs a tank"),defaults)==null,"removing general phrase disables recognition");
        defaults.lfmWords=["needs"];check(p.parse(event("TC needs a tank"),defaults)!=null,"restored general phrase works");
        check(p.parse(event("needs advice"),defaults)==null,"general verb alone cannot create listing");
        defaults.excludedWords=["tank"];check(p.parse(event("TC needs a tank"),defaults)==null,"exclusions override recognition");
        check(Config.words(["LFG","lfg","",42,"  party up  "],[]).length==2,"validated deduplicated phrase list");
        var a=new Alerts();var b=new Board(p);c.watchActivities=["test"];c.alertsEnabled=true;
        b.enqueue(event("LF1M TC"));b.update(c,100);a.update(b,c,"me",100);
        check(a.unread==1&&a.toastUntil==108,"watched group alerts once");
        b.enqueue(event("LF2M TC","host",101));b.update(c,101);a.update(b,c,"me",101);check(a.unread==1,"repost stays silent");
        b.enqueue(event("LF2M TC","me",102));b.enqueue(event("party up TC","solo",102));b.update(c,102);a.update(b,c,"me",102);
        check(a.unread==1,"self and solo posts do not alert");
        b.enqueue(event("LF1M TC","second",103));b.update(c,103);a.update(b,c,"me",103);check(a.unread==2&&a.toastUntil==108,"coalesce burst without restarting toast");
        a.update(b,c,"me",110);check(a.toastUntil==118,"pending new groups receive later toast");
        a.acknowledge();check(a.unread==0&&a.toastUntil==0,"acknowledge clears badge and toast");
        b.update(c,500);a.update(b,c,"me",500);b.enqueue(event("LF1M TC","host",501));b.update(c,501);a.update(b,c,"me",501);
        check(a.unread==1,"expired listing can alert again");
        a.reset();check(a.unread==0,"session reset clears alerts");
        c.alertsEnabled=false;a.update(b,c,"me",502);check(a.unread==0,"disabled alerts stay quiet");
        c.alertsEnabled=true;c.expirySeconds=300;b.clear();a.reset();
        b.enqueue(event("LF1M TC","early",600));b.update(c,600);a.update(b,c,"me",600);
        b.enqueue(event("LF1M TC","pending",601));b.update(c,601);a.update(b,c,"me",601);
        var pendingKey=b.entries[1].key;b.hide(pendingKey);a.update(b,c,"me",602);
        check(a.unread==1,"hidden pending listing removed from unread count");
        a.update(b,c,"me",610);check(a.toastUntil==608,"hidden pending listing cannot emit later toast");
        b.entries[1].hidden=false;a.update(b,c,"me",610.5);check(a.toastUntil==608,"unhide does not reset deduplication before expiry");
        b.ignore("early","early",c,611);a.update(b,c,"me",611);check(a.unread==0,"ignored listing removes badge");
        c.ignored=[];b.enqueue(event("LF1M TC","early",612));b.update(c,612);a.update(b,c,"me",612);check(a.unread==0,"unignore repost remains deduplicated until original expiry");
        b.clear();a.reset();b.enqueue(event("LF1M TC","expires",700));b.update(c,700);a.update(b,c,"me",700);
        a.update(b,c,"me",1001);check(a.unread==0,"expired entry in cached board cannot keep unread badge");
        b.clear();a.reset();b.enqueue(event("LF1M TC","returning",1200));b.update(c,1200);a.update(b,c,"me",1200);a.acknowledge();
        b.enqueue(event("LF1M TC","returning",1501));b.update(c,1501);a.update(b,c,"me",1501);check(a.unread==1,"expiry and repost in one service tick can alert anew");
        c.watchActivities=["custom:unknown ruins"];b.clear();a.reset();b.enqueue(event("LF1M [Unknown Ruins]","custom",1100));b.update(c,1100);a.update(b,c,"me",1100);
        check(a.unread==1,"custom activity watch");
        var d=new Draft();d.activity="Test Cavern";d.difficulty="Heroic";d.bonusRuns=true;
        check(Parser.preview(d).indexOf("Heroic - Bonus Runs")>=0,"bonus runs in preview");
        check(d.copy().bonusRuns,"template clone keeps Bonus Runs");
        c.draft=d;c.templates=[d.copy()];c.theme="Custom";c.accent=0x123456;c.alertsEnabled=true;
        var restored=Config.decode(c.encode());check(restored.draft.bonusRuns&&restored.templates[0].bonusRuns,"bonus persistence");
        check(restored.theme=="Custom"&&restored.accent==0x123456,"theme persistence");
        c.background=0x112233;c.surface=0x223344;c.foreground=0xDDEEFF;c.opacity=0.8;c.textScale=1.3;c.highContrast=true;
        restored=Config.decode(c.encode());check(restored.background==c.background&&restored.surface==c.surface&&restored.foreground==c.foreground&&restored.opacity==0.8&&restored.textScale==1.3&&restored.highContrast,"complete appearance persistence");
        check(restored.lfgWords[0]=="party up"&&restored.watchActivities[0]=="custom:unknown ruins","filter and watch persistence");
        check(Config.decode('{"draft":{"difficulty":"Veteran"}}').draft.difficulty=="Veteran","existing difficulty migration");
        check(Config.decode('{"draft":{"difficulty":"unknown"}}').draft.difficulty=="Normal","unknown difficulty defaults Normal");
        check(Config.decode('{"draft":{"difficulty":""}}').draft.difficulty=="Normal","empty difficulty defaults Normal");
        var legacy=Config.decode('{"width":720,"draft":{"activity":"TC"}}');check(legacy.launcherEnabled&&!legacy.alertsEnabled&&!legacy.draft.bonusRuns,"legacy safe defaults");
        c.width=720;c.height=480;c.windowX=9999;c.windowY=9999;check(Geometry.x(c,1920)==1200&&Geometry.y(c,1080)==600,"offscreen window clamp");
        check(Geometry.launcherX(c,1920)==1428&&Geometry.launcherY(c,1080)==1020,"fixed Chat button placement");
        check(Geometry.fitScale(200,100,40)==0.2&&Geometry.fitScale(100,200,40)==0.2,"artwork keeps wide and tall aspect ratio");
        check(Geometry.fitScale(0,10,40)==0,"invalid artwork size safe");
        var adapter=new FakeChat();var engine=new Engine(new Config(),adapter,p);engine.tick(1200);
        check(engine.previewCurrent(),"initial preview synchronized");
        engine.config.draft.activity="Test Cavern";engine.config.draft.difficulty="Heroic";engine.config.draft.bonusRuns=true;engine.markDirty(1201);
        check(!engine.previewCurrent(),"same-frame edit disables stale preview submission");engine.tick(1201);
        var reviewed=engine.preview;engine.enqueue(engine.action("post",reviewed,"Local"));engine.tick(1202);
        check(adapter.calls.length==1&&adapter.calls[0].text==reviewed&&reviewed.indexOf("Heroic - Bonus Runs")>0,"send exact reviewed bonus and difficulty text");
        check(engine.postFeedback!=""&&engine.whisperFeedback=="","post feedback stays separate");
        engine.report("whisper","Offline player",1203);check(engine.whisperFeedback=="Offline player"&&engine.postFeedback.indexOf("Post submitted")==0,"whisper feedback does not overwrite post feedback");
        engine.saveTemplate(1203);check(engine.config.templates.length==1&&engine.config.templates[0].bonusRuns&&Config.decode(engine.config.encode()).templates[0].bonusRuns,"saved template preserves Bonus Runs through settings encode");
        engine.config.draft.bonusRuns=false;check(Parser.preview(engine.config.draft).indexOf("Bonus Runs")<0,"unchecked bonus omitted");
        engine.config.draft.difficulty="bad";check(Parser.preview(engine.config.draft).indexOf("Normal")>=0,"preview restricts invalid difficulty");
        Sys.println("PASS "+n+" usability feature checks");
    }
}
